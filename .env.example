# Copie para .env.local e preencha com valores reais.
# Veja CLAUDE.md para o significado de cada URL (pooler vs conexão direta).

# Conexão da aplicação em runtime (via pooler, porta 6543)
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true"

# Conexão direta, usada por Prisma Migrate/seed (porta 5432)
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# Chave usada pelo NextAuth pra assinar sessões/JWTs — gerar com `openssl rand -base64 32`
AUTH_SECRET=""

# URL base da aplicação (usada pelo NextAuth em callbacks/redirects)
NEXTAUTH_URL="http://localhost:3010"
